+#wifiModal .wifi-if-table .wifi-if-conn { color: #6c757d; }
+#wifiModal .wifi-grp-title { font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: #6c757d; margin: 14px 0 6px; }
+#wifiModal .wifi-list { border: 1px solid #e9ecef; border-radius: 8px; overflow: visible; }
+#wifiModal .wifi-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-bottom: 1px solid #f1f3f5; cursor: default; }
+#wifiModal .wifi-row:last-child { border-bottom: none; }
+#wifiModal .wifi-row.wifi-clickable { cursor: pointer; }
+#wifiModal .wifi-row.wifi-clickable:hover { background: #f8f9fa; }
+#wifiModal .wifi-row.wifi-connected { background: #f2fbf4; }
+#wifiModal .wifi-row.wifi-limited { opacity: .55; }
+#wifiModal .wifi-row .wifi-grow { flex: 1; min-width: 0; }
+#wifiModal .wifi-row .wifi-name { font-weight: 600; }
+#wifiModal .wifi-row .wifi-meta { font-size: .8rem; color: #6c757d; }
+#wifiModal .wifi-add-row { padding: 10px 12px; color: #007bff; cursor: pointer; }
+#wifiModal .wifi-add-row:hover { background: #f8f9fa; }
+#wifiModal .wifi-disabled-area { opacity: .45; pointer-events: none; }
+/* busy: a long operation is running — block all controls, keep the status line readable */
+#wifiModal.wifi-busy .modal-body { pointer-events: none; }
+#wifiModal.wifi-busy #wifi-net-list, #wifiModal.wifi-busy #wifi-ap-card { opacity: .5; }
+/* floating toast, bottom-center (prototype): info teal, error red, busy = persistent w/ spinner */
+#wifi-toast { display: none; position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%);
+  background: #17a2b8; color: #fff; padding: 10px 18px; border-radius: 8px;
+  box-shadow: 0 4px 16px rgba(0,0,0,.2); z-index: 2000; max-width: 90vw; }
+#wifi-toast.wifi-toast-error { background: #dc3545; }
+#wifi-toast .spinner-border { vertical-align: -2px; margin-right: 6px; }
