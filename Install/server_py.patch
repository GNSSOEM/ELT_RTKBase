+#### WiFi manager ####
+# Thin Socket.IO handlers over wifi_manager.py. Long operations (scan, connect,
+# hotspot start) run as background tasks so the gevent worker stays responsive.
+
+# Child of the wifi_manager logger: one setLevel in main() covers both, and the lines
+# land in the journal through the same root handler (network_infos' basicConfig).
+wifi_log = logging.getLogger("wifi_manager.server")
+
+def wifi_emit_error(operation, exception):
+    wifi_log.warning("wifi: %s failed: %s", operation, exception)
+    socketio.emit("wifi error", {"op": operation, "message": str(exception)}, namespace="/test")
+
+def wifi_emit_list(rescan=False):
+    socketio.emit("wifi list", wifi_manager.list_networks(rescan=rescan), namespace="/test")
+
+def wifi_emit_status():
+    hide = rtkbaseconfig.get("general", "wifi_hide_countries", fallback="").strip("'\"")
+    status = wifi_manager.get_status()
+    status["hide_countries"] = [c for c in hide.split(",") if c.strip()]
+    socketio.emit("wifi status", status, namespace="/test")
+
+def wifi_status_refresh():
+    # interface addresses changed (connect/disconnect/IP/AP) — refresh the popup header
+    try:
+        wifi_emit_status()
+    except Exception as e:
+        print("wifi status refresh:", e)
+
+def wifi_connect_status(stage, detail):
+    socketio.emit("wifi connect status", {"stage": stage, "detail": detail}, namespace="/test")
+
+@socketio.on("get wifi status", namespace="/test")
+def get_wifi_status():
+    try:
+        # NM does not persist the radio state reliably — force it on
+        # when the popup opens.
+        wifi_manager.radio_wifi_on()
+    except Exception as e:
+        print("wifi radio on:", e)
+    try:
+        wifi_emit_status()
+    except Exception as e:
+        wifi_emit_error("status", e)
+
+@socketio.on("get wifi countries", namespace="/test")
+def get_wifi_countries():
+    try:
+        hide = rtkbaseconfig.get("general", "wifi_hide_countries", fallback="").strip("'\"")
+        countries = wifi_manager.get_countries(hide.split(",") if hide else ())
+        socketio.emit("wifi countries", countries, namespace="/test")
+    except Exception as e:
+        wifi_emit_error("countries", e)
+
+@socketio.on("get wifi list", namespace="/test")
+def get_wifi_list():
+    def task():
+        try:
+            # popup open: force a fresh scan (the cached one may be empty/stale)
+            wifi_emit_list(rescan=True)
+        except Exception as e:
+            wifi_emit_error("list", e)
+    socketio.start_background_task(task)
+
+@socketio.on("wifi rescan", namespace="/test")
+def wifi_rescan():
+    def task():
+        try:
+            # header first: interface addresses change too (AP IP, DHCP renew, clients);
+            # the popup's periodic tick relies on this to keep the header fresh
+            wifi_emit_status()
+            wifi_emit_list(rescan=True)   # `nmcli ... --rescan yes` blocks until the scan finishes
+        except Exception as e:
+            wifi_emit_error("rescan", e)
+    socketio.start_background_task(task)
+
+@socketio.on("wifi probe hidden", namespace="/test")
+def wifi_probe_hidden(json_msg):
+    """Ask a hidden network what it is, so the dialog can fill the security in instead of
+    asking the operator to know it."""
+    ssid = (json_msg or {}).get("ssid") or ""
+
+    def task():
+        try:
+            hit = wifi_manager.probe_hidden(ssid)
+        except Exception as e:
+            wifi_emit_error("probe", e)
+            return
+        socketio.emit("wifi hidden probe",
+                      dict({"ssid": ssid, "found": bool(hit)}, **(hit or {})),
+                      namespace="/test")
+    socketio.start_background_task(task)
+
+@socketio.on("wifi radio", namespace="/test")
+def wifi_radio(json_msg):
+    on = bool(json_msg.get("on"))
+    try:
+        wifi_manager.set_radio(on)
+        wifi_emit_status()
+    except Exception as e:
+        wifi_emit_error("radio", e)
+        return
+    # After power-on the scan cache is empty; force a fresh (blocking) scan in a
+    # background task so the list isn't briefly shown as "No networks found".
+    def task():
+        try:
+            wifi_emit_list(rescan=on)
+            # radio off also deactivates a live hotspot (NM behaviour) and radio on brings
+            # it back via autoconnect — re-sync the AP form so its toggle reflects reality
+            socketio.emit("ap config", wifi_manager.get_ap_config(), namespace="/test")
+        except Exception as e:
+            wifi_emit_error("radio", e)
+    socketio.start_background_task(task)
+
+@socketio.on("wifi set country", namespace="/test")
+def wifi_set_country(json_msg):
+    def task():
+        try:
+            requested = (json_msg.get("country") or "").strip().upper()
+            wifi_manager.set_country(requested)
+            # regdomain re-applied: NM may drop and re-associate
+            wifi_manager.poll_reconnect(15, wifi_connect_status)
+            # if the kernel couldn't settle on the requested country, say why the region
+            # didn't stick — otherwise the picker just silently blanks. Two known causes,
+            # told apart by the link state: associated → the AP's 802.11d country IE
+            # intersects the domain; otherwise the kernel itself rejected the code (its
+            # regulatory database has no entry for it — shouldn't happen with the picker
+            # filtered by that database, but imports carry free-form codes).
+            if requested and wifi_manager.get_country() != requested:
+                state = (wifi_manager.wifi_state().get("state") or "")
+                if state.startswith("connected"):
+                    wifi_emit_error("region", "Region {} could not be fully applied — the "
+                                    "connected network enforces a different regulatory domain. "
+                                    "Disconnect to change the region.".format(requested))
+                else:
+                    wifi_emit_error("region", "Region {} was not accepted by the system — the "
+                                    "WiFi regulatory database has no rules for this country. "
+                                    "Please pick another region.".format(requested))
+            wifi_emit_status()
+            wifi_emit_list()
+            # terminal event LAST (like "wifi connect result"): the dialog stays locked
+            # until the status/list it will show alongside the confirmation are fresh
+            socketio.emit("wifi country result", {"ok": True}, namespace="/test")
+        except Exception as e:
+            wifi_emit_error("set country", e)
+    socketio.start_background_task(task)
+
+@socketio.on("wifi connect", namespace="/test")
+def wifi_connect(json_msg):
+    def task():
+        try:
+            networks = wifi_manager.connect(
+                ssid=json_msg.get("ssid", ""),
+                password=json_msg.get("password"),
+                security=json_msg.get("security"),
+                hidden=bool(json_msg.get("hidden")),
+                remember=bool(json_msg.get("remember", True)),
+                ipconf=json_msg.get("ipconf"),
+                bssid=json_msg.get("bssid"),
+                status_cb=wifi_connect_status)
+            # terminal event ("wifi connect result") goes LAST: the UI stays busy until
+            # the header and list it will show alongside the final toast are fresh
+            wifi_status_refresh()
+            socketio.emit("wifi list", networks, namespace="/test")
+            socketio.emit("wifi connect result", {"ok": True}, namespace="/test")
+        except wifi_manager.WifiError as e:
+            wifi_log.warning("wifi: connect '%s' failed: %s", json_msg.get("ssid", ""), e)
+            socketio.emit("wifi connect result", {"ok": False, "message": str(e)}, namespace="/test")
+        except Exception as e:
+            wifi_log.warning("wifi: connect '%s' failed: %s", json_msg.get("ssid", ""), e)
+            socketio.emit("wifi connect result", {"ok": False, "message": str(e)}, namespace="/test")
+    socketio.start_background_task(task)
+
+@socketio.on("wifi activate", namespace="/test")
+def wifi_activate(json_msg):
+    # Re-connect to an already-saved network: activate the stored profile, no password prompt.
+    def task():
+        try:
+            networks = wifi_manager.activate(json_msg.get("profile"),
+                                             bssid=json_msg.get("bssid"),
+                                             status_cb=wifi_connect_status)
+            wifi_status_refresh()
+            socketio.emit("wifi list", networks, namespace="/test")
+            socketio.emit("wifi connect result", {"ok": True}, namespace="/test")
+        except Exception as e:
+            wifi_log.warning("wifi: activate '%s' failed: %s", json_msg.get("profile", ""), e)
+            socketio.emit("wifi connect result", {"ok": False, "message": str(e)}, namespace="/test")
+    socketio.start_background_task(task)
+
+@socketio.on("wifi disconnect", namespace="/test")
+def wifi_disconnect():
+    def task():
+        try:
+            networks = wifi_manager.disconnect()
+            wifi_status_refresh()
+            socketio.emit("wifi list", networks, namespace="/test")
+        except Exception as e:
+            wifi_emit_error("disconnect", e)
+    socketio.start_background_task(task)
+
+@socketio.on("wifi forget", namespace="/test")
+def wifi_forget(json_msg):
+    try:
+        networks = wifi_manager.forget(json_msg.get("profile"))
+        wifi_status_refresh()
+        socketio.emit("wifi list", networks, namespace="/test")
+    except Exception as e:
+        wifi_emit_error("forget", e)
+
+@socketio.on("wifi change password", namespace="/test")
+def wifi_change_password(json_msg):
+    try:
+        networks = wifi_manager.change_password(json_msg.get("profile"), json_msg.get("password", ""))
+        socketio.emit("wifi list", networks, namespace="/test")
+    except Exception as e:
+        wifi_emit_error("change password", e)
+
+@socketio.on("wifi set autoconnect", namespace="/test")
+def wifi_set_autoconnect(json_msg):
+    def task():
+        try:
+            networks = wifi_manager.set_autoconnect(json_msg.get("profile"),
+                                                    bool(json_msg.get("on")))
+            socketio.emit("wifi list", networks, namespace="/test")
+        except Exception as e:
+            wifi_emit_error("autoconnect", e)
+    socketio.start_background_task(task)
+
+@socketio.on("wifi set ipconf", namespace="/test")
+def wifi_set_ipconf(json_msg):
+    def task():
+        try:
+            networks = wifi_manager.set_ip_config(json_msg.get("profile"), json_msg.get("ipconf"))
+            wifi_status_refresh()
+            socketio.emit("wifi list", networks, namespace="/test")
+        except Exception as e:
+            wifi_emit_error("set ipconf", e)
+    socketio.start_background_task(task)
+
+@socketio.on("get ap config", namespace="/test")
+def get_ap_config():
+    try:
+        socketio.emit("ap config", wifi_manager.get_ap_config(), namespace="/test")
+    except Exception as e:
+        wifi_emit_error("ap config", e)
+
+@socketio.on("wifi set ap", namespace="/test")
+def wifi_set_ap(json_msg):
+    def task():
+        try:
+            config = wifi_manager.set_ap(json_msg, status_cb=wifi_connect_status)
+            wifi_status_refresh()
+            wifi_emit_list()
+            socketio.emit("ap config", config, namespace="/test")
+        except Exception as e:
+            wifi_emit_error("set ap", e)
+            # push the refreshed config too: it carries last_error, which the AP card
+            # shows persistently (the error toast alone disappears)
+            try:
+                socketio.emit("ap config", wifi_manager.get_ap_config(), namespace="/test")
+            except Exception:
+                pass
+    socketio.start_background_task(task)
+
+# background moves of the access point (the coupling follows the client's channel, the
+# watchdog raises/lowers the beacon) must reach an open dialog — otherwise its card keeps
+# showing the moment of the last click (п.73/85)
+def _wifi_ap_changed():
+    try:
+        socketio.emit("ap config", wifi_manager.get_ap_config(), namespace="/test")
+    except Exception as e:
+        print("ap config push:", e)
+wifi_manager.on_ap_changed = _wifi_ap_changed
+
+@socketio.on("wifi set ap auto", namespace="/test")
+def wifi_set_ap_auto(json_msg):
+    # the Auto toggle alone (no form): off always applies, on only next to a saved point —
+    # the dialog defers arming to Save everywhere else
+    def task():
+        try:
+            config, lowered = wifi_manager.set_ap_auto(bool(json_msg.get("auto")))
+            # the ap config first: it is what unlocks the dialog. A plain flag write
+            # changes nothing else; the heavy status/list broadcasts go out only when
+            # the toggle actually lowered the watchdog's point
+            socketio.emit("ap config", config, namespace="/test")
+            if lowered:
+                wifi_status_refresh()
+                wifi_emit_list()
+        except Exception as e:
+            wifi_emit_error("set ap auto", e)
+            try:
+                socketio.emit("ap config", wifi_manager.get_ap_config(), namespace="/test")
+            except Exception:
+                pass
+    socketio.start_background_task(task)
+
