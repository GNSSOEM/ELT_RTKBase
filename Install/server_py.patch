+def get_station_name():
+    """
+        The hostname is used as the station name unless it is "rtkbase."
+        If the hostname is "rtkbase," the Mount name from NTRIP A is used.
+        If it is not specified, the IP is used.
+    """
+    hostname = socket.gethostname()
+    #mountname = rtkbaseconfig.get_ntrip_mountname_A()
+    #primary_ip = network_infos.get_primary_ip()
+    if hostname != "rtkbase":
+        station_name = hostname
+    else:
+        mountname = rtkbaseconfig.get_ntrip_mountname_A()
+        if mountname != "":
+            station_name = mountname
+        else:
+            primary_ip = network_infos.get_primary_ip()
+            station_name = primary_ip
+
+    #print("station_name=", station_name, "hostname=", hostname, "mountname=", mountname, "primary_ip=", primary_ip)
+    return station_name
+
+def slugify_station_part(value, max_length=24):
+    """
+    Convert a value to a cookie-name-safe fragment.
+    """
+    value = str(value or "").strip().lower()
+
+    # Replace everything except ASCII letters and digits
+    value = re.sub(r"[^a-z0-9]+", "_", value)
+    value = value.strip("_")
+
+    return value[:max_length] or "unknown"
+
+def make_station_id(station_name):
+    source = slugify_station_part(station_name)
+    digest = hashlib.sha256(source.encode()).hexdigest()[:8]
+
+    return f"{source}__{digest}"
+
+station_name = get_station_name()
+station_id = make_station_id(station_name)
+
+app.config["SESSION_COOKIE_NAME"] = (
+    f"rtkbase_session_{station_id}"
+)
+app.config["REMEMBER_COOKIE_NAME"] = (
+    f"rtkbase_remember_{station_id}"
+)
