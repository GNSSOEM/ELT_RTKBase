-rm /usr/bin/conv2bin
-rm /usr/bin/rtkrcv
+rm /usr/local/bin/str2str
+rm /usr/local/bin/conv2bin
+rm /usr/local/bin/rtkrcv
+rm /usr/local/bin/rtkrcv.nav
+rm /usr/local/bin/NmeaConf
