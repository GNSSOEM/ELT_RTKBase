# Wi-Fi settings of THIS station — things that cannot be detected, only declared.
#
# This file ships with the software and holds the defaults. To change a setting on a
# station, put the same section with the changed key in
#
#     /usr/local/rtkbase/rtkbase/wifi_manager.conf
#
# which is read after this one and wins. It sits next to settings.conf, so it is a station's
# own file in the same sense settings.conf is: "Reset settings" does not touch it, and keeping
# it across a software update is the installer's business. Provisioning writes it; the
# configurator reads it all and writes back the keys the web UI owns a control for
# (hotspot_rescue, via the access-point mode switch) — one key at a time, leaving every other
# line as it was. Both paths come from the code — if the software is installed somewhere
# else, the file goes next to that installation's settings.conf, not to this absolute path.
#
# Values accept true/false, yes/no, on/off, 1/0, with or without quotes.

[wifi]

# The station is installed outdoors.
# Regulators mark part of 5 GHz indoor-only (in Latvia, for instance, that is 5150-5350,
# i.e. channels 36-64). With this on, such channels are not offered for the access point
# and are refused if a profile still carries one. Nothing can detect this — only whoever
# mounted the station knows.
outdoor = false

# Channels this station's adapter cannot use for an access point.
# Some adapters accept a channel in every regulatory table and then refuse it in firmware. On
# a Raspberry Pi with the Broadcom radio (brcmfmac) the whole upper 5 GHz band behaves that
# way: the kernel log shows
#
#     brcmf_cfg80211_reg_notifier: Firmware rejected country setting
#     brcmf_cfg80211_start_ap: Set Channel failed: chspec=53397, -52
#
# (0xD095 is channel 149 at 20 MHz), and the interface only sees a supplicant timeout. Nothing
# in `iw reg get` or `iw phy` predicts it — both list those channels as allowed at full power —
# so it has to be declared here. Listed channels are not offered in the access-point form and
# are refused on save; client connections are not affected.
#
# Deliberately without a value: an adapter that is fine keeps every channel its region allows.
# For the Raspberry Pi radio of these stations, measured one channel at a time in region ID —
# 149, 153, 157 and 161 all refused to start, while 36 and 48 came up normally:
#
#     unavailable_channels = 149, 153, 157, 161, 165
#
# 165 is in the list by band, not by measurement: the kernel does not offer it in the regions
# we could test, so it was never actually attempted.
#
# One more reason a channel can belong here: the radio's own regulatory table may allow more
# power than the country does — in Latvia, for instance, the country caps 5745-5825 at 13 dBm
# while the radio's table says 20. An adapter that cannot transmit below its own table's limit
# either refuses to start or, worse, transmits above what the country allows. We do not guess
# which of the two happens: the earlier rule that hid such channels automatically was removed
# after measurement showed the refusal has nothing to do with the power gap (the upper 5 GHz
# band is refused even where the country allows MORE than the radio). If a channel is unlawful
# for this station, list it here.
#
unavailable_channels =

# Raise the access point when the station is left with no network at all.
# When there is no Wi-Fi connection and no cable carrier for a few minutes, the hotspot
# comes up so the station stays reachable, and goes down again once the station is back
# online. Client networks keep their autoconnect, so the station rejoins by itself.
# Especially useful for stations without Ethernet. Shipped on, so a fresh station left
# with no network raises its point instead of going dark; set to false for a station that
# is meant to stay silent.
# This is the one key the web UI writes too: the access-point mode switch ("Auto" sets it
# to true, leaving to "Off"/"On" sets it back to false), so it can change at runtime.
hotspot_rescue = true

# Out-of-the-box settings of the access point, before the operator saves it once.
# They pre-fill the form of a not-yet-created point, and a first Save with the key field
# left untouched uses the default key. A fleet order can put its own address plan and key
# here — one place to change, one set of values for the documentation. Once the point is
# saved, its profile is the truth and these are not consulted again.
ap_default_ip = 192.168.1.1
ap_default_prefix = 24
ap_default_password = 12345678

# Extra journal detail for the Wi-Fi zone (DEBUG lines): the watchdog's periodic
# "alive" heartbeat, channel-follow decisions during a connection attempt, and similar.
# The operation trail itself (connections, the point rising and falling, losses and
# recoveries) is always in the journal regardless of this switch. Applied when the web
# service starts — edit, then restart the service.
debug = false
